AXE_STRICT_MODE=true
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_SECONDS=20

HTTP_PORT=8080
AXE_DATA_DIR=/var/lib/axe

AXE_API_KEY=replace-with-long-random-key
AXE_HMAC_SECRET=replace-with-long-random-hmac-secret
AXE_RATE_LIMIT_PER_MINUTE=600
AXE_TRUSTED_CIDRS=10.0.0.0/8,192.168.0.0/16

# Service-to-service URLs (for watcher/indexer deployments)
ENGINE_URL=http://axe-engine:8080
INDEXER_URL=http://axe-indexer:8081
WATCH_INTERVAL_SECONDS=2
WATCHER_MAX_SYNC_LAG_SECONDS=300

# Bitcoin source mode: mock | rpc
AXE_BITCOIN_MODE=rpc
BITCOIN_RPC_URL=http://bitcoind:8332
BITCOIN_RPC_USER=replace-rpc-user
BITCOIN_RPC_PASS=replace-rpc-pass
BITCOIN_START_HEIGHT=0
BITCOIN_CONFIRMATIONS=2
INDEXER_MAX_RETRIES=3
INDEXER_MAX_DEAD_LETTERS=100
