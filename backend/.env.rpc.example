# Public test-style chain = Bitcoin Signet (same chain everyone uses; not a private "my net").
# Recommended: run backend/docker-compose.yml (includes signet bitcoind) and point RPC at that node.
#
# From your Mac (host) to the published container port:
#   BITCOIN_RPC_URL=http://127.0.0.1:39332
#   BITCOIN_RPC_USER=axe-rpc
#   BITCOIN_RPC_PASS=axe-rpc-pass
# (defaults match docker-compose.yml unless you overrode BITCOIN_RPC_USER/PASS there.)
#
# From inside Docker on the compose network (axe-indexer service):
#   BITCOIN_RPC_URL=http://bitcoin-core:39332
#
# Third-party Signet RPC: this indexer uses JSON-RPC over HTTP with Basic Auth only.
# If a provider expects x-api-key or a path key (e.g. Alchemy/Tatum), use a local proxy or extend the client.
AXE_BITCOIN_MODE=rpc
BITCOIN_RPC_URL=http://127.0.0.1:39332
BITCOIN_RPC_USER=axe-rpc
BITCOIN_RPC_PASS=axe-rpc-pass
BITCOIN_START_HEIGHT=0
BITCOIN_CONFIRMATIONS=2
INDEXER_MAX_RETRIES=3
INDEXER_MAX_DEAD_LETTERS=100
