# Public site URL (metadata, sitemap, JSON-LD). Default: https://testnet.btc-defi.com
# NEXT_PUBLIC_BPVP_SITE_URL=https://testnet.btc-defi.com

ENGINE_URL=http://localhost:28080
INDEXER_URL=http://localhost:28081
WATCHER_URL=http://localhost:28082

AXE_API_KEY=replace-with-same-backend-api-key
DASHBOARD_PASSWORD=replace-with-strong-password
AXE_HMAC_SECRET=replace-with-backend-hmac-secret

# Auth v2 (optional, recommended for multi-user + roles)
# Format:
# BPVP_AUTH_USERS_JSON=[{"username":"admin","password":"...","role":"admin","otpSecret":"123456"},{"username":"trader1","password":"...","role":"trader"}]
BPVP_AUTH_USERS_JSON=
# Optional explicit signing secret for dashboard sessions
BPVP_AUTH_SIGNING_SECRET=
# Optional path for auth users store (default: ../.run/auth-users.json)
BPVP_AUTH_USER_STORE=

# Bridge mode (recommended default)
BPVP_ENABLE_BRIDGE=false
NEXT_PUBLIC_BPVP_ENABLE_BRIDGE=false

# Bridge controller hardening (optional)
BPVP_BRIDGE_OPS_TOKEN=
BPVP_BRIDGE_WEBHOOK_URL=
BPVP_BRIDGE_WEBHOOK_SECRET=

# Quant policy tuning
BPVP_ALERT_RED_QUALITY_SCORE=70
BPVP_ALERT_AMBER_QUALITY_SCORE=85
BPVP_ALERT_RED_SYNC_LAG=100000
BPVP_ALERT_AMBER_SYNC_LAG=10000
BPVP_ALERT_AMBER_VELOCITY_BPM=0.05
BPVP_VELOCITY_WINDOW_POINTS=12
BPVP_QUALITY_LAG_PENALTY_THRESHOLD=1000
BPVP_QUALITY_LAG_PENALTY_VALUE=10
BPVP_QUALITY_SERVICE_PENALTY=40
BPVP_QUALITY_MONOTONIC_PENALTY=25
BPVP_QUALITY_WATCHER_AHEAD_PENALTY=20
BPVP_QUALITY_TARGET_BELOW_PENALTY=10
